# Copy to .env and fill in. Never commit a real .env file.

DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_GUILD_ID=000000000000000000
# Comma-separated allowlist. Only these channels are read.
SOURCE_CHANNEL_IDS=000000000000000000,000000000000000000
REPORT_CHANNEL_ID=000000000000000000

# Any provider exposing an OpenAI-compatible chat-completions endpoint works.
# Point these at your provider, a gateway, or a local server.
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-your-provider-api-key
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_MODEL=your-model
# Example: Perplexity Sonar uses https://api.perplexity.ai with model "sonar".
# Set LLM_PROVIDER=sonar to enable that adapter; it is currently the only one
# that supports the optional public-research lane. "openai" names the compatible
# API adapter, not a requirement to use OpenAI's hosting.
# See docs/investigations.md. No provider access is bundled with this project.

# IANA timezone used for report period boundaries.
REPORT_TIMEZONE=UTC
REPORT_WEEKDAY=0
REPORT_HOUR=9
ANALYSIS_DAYS=7
RETENTION_DAYS=30
MAX_MESSAGES=20000
MAX_LLM_REQUESTS=200
# Set true only after completing docs/operations.md. Never enables model training.
LLM_PROCESSING_APPROVED=false

# Random secret, at least 16 characters. Rotating it breaks author linkage.
AUTHOR_HASH_SALT=replace-with-a-long-random-secret

# Use /data/seismograph.db with a mounted volume when running in Docker.
DATABASE_PATH=/data/seismograph.db
