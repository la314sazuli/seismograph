include CHANGELOG.md CONTRIBUTING.md SECURITY.md Dockerfile .dockerignore .env.example .gitignore
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py
recursive-include evaluations *.json *.md
recursive-include .github *.yml *.md
global-exclude __pycache__ *.py[cod] *.db *.db-* *.sqlite *.sqlite3 .env *.pem *.key
